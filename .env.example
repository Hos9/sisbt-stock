# Copy this file to .env and fill in your own Supabase project values.
# Find both of these under Project Settings -> API in your Supabase dashboard.
# Only the anon/public key goes here — NEVER put the service_role key
# in this file or anywhere in the frontend code.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
